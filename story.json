  "nodes": {
    "cover": {
      "text": "You are a dragon. A big one. Last week you burnt a whole castle, and you were very proud. But today your scales are SO itchy you can't even nap.",
      "image": "images/dragon.svg",
      "choices": [{ "text": "Turn the page", "next": [{ "node": "princess" }] }]
    },
    "princess": {
      "text": "Stomp, stomp. A princess marches up to your cave. She is wearing a paper bag. \"I was going to trick you,\" she says, \"but you look awful. Tell me what's wrong and I will run a note to the Royal Healer.\"",
      "image": "images/princess.svg",
      "choices": [{ "text": ["hello princess", "hi"], "next": [{ "node": "bag" }] }]
    },
    "bag": {
      "showLetters": true,
      "text": "\"One problem,\" she says. \"Your fire burnt every letter in the kingdom. I saved 5 of each in my paper bag. Every word you say uses them up. Each row is one answer with a few ways to say it: long ones cost more letters. If you run out, you can take an answer back and say it shorter.\"",
      "image": "images/bag.svg",
      "choices": [{ "text": ["got it", "ok", "mm"], "next": [{ "node": "q_where" }] }]
    },

    "q_where": {
      "text": "\"Where are your scales itchy?\" (Your wing is your arm. Your wing fold is inside your elbow. Your snout is your face. Your claws are your hands.)",
      "image": "images/dragon.svg",
      "choices": [
        { "text": ["it itches in my wing folds", "in my wing folds", "wing folds"], "condition": { "not": ["s_elbow"] }, "set": { "spot": "inside elbows", "spotKid": "wing folds" }, "setFlags": ["s_elbow"], "addItems": ["wing folds"], "next": [{ "node": "q_look" }] },
        { "text": ["it itches in my knee folds", "in my knee folds", "knee folds"], "condition": { "not": ["s_knee"] }, "set": { "spot": "behind knees", "spotKid": "knee folds" }, "setFlags": ["s_knee"], "addItems": ["knee folds"], "next": [{ "node": "q_look" }] },
        { "text": ["it itches on my wing", "on my wing", "wing"], "condition": { "not": ["s_arm"] }, "set": { "spot": "arm", "spotKid": "wing" }, "setFlags": ["s_arm"], "addItems": ["wing"], "next": [{ "node": "q_look" }] },
        { "text": ["it itches on my leg", "on my leg", "leg", "calf"], "condition": { "not": ["s_leg"] }, "set": { "spot": "leg", "spotKid": "leg" }, "setFlags": ["s_leg"], "addItems": ["leg"], "next": [{ "node": "q_look" }] },
        { "text": ["it itches on my claws", "on my claws", "claws"], "condition": { "not": ["s_hand"] }, "set": { "spot": "hands", "spotKid": "claws" }, "setFlags": ["s_hand"], "addItems": ["claws"], "next": [{ "node": "q_look" }] },
        { "text": ["it itches on my snout", "on my snout", "snout"], "condition": { "not": ["s_face"] }, "set": { "spot": "face", "spotKid": "snout" }, "setFlags": ["s_face"], "addItems": ["snout"], "next": [{ "node": "q_look" }] },
        { "text": ["it itches on my neck", "on my neck", "neck"], "condition": { "not": ["s_neck"] }, "set": { "spot": "neck", "spotKid": "neck" }, "setFlags": ["s_neck"], "addItems": ["neck"], "next": [{ "node": "q_look" }] }
