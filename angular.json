{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "photo-intake": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pill-bottle.jpg",
                "input": "patients/persistent-pain",
                "output": "samples"
              },
              {
                "glob": "elbow-photo.png",
                "input": "patients/eczema",
                "output": "samples"
              },
              {
                "glob": "pen-photo.jpg",
                "input": "patients/glp1",
                "output": "samples"
              },
              {
                "glob": "xray-2021.jpg",
                "input": "patients/strained-back",
                "output": "samples"
              },
              {
                "glob": "optic-disc-2023.png",
                "input": "patients/glaucoma",
                "output": "samples"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "48kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "photo-intake:build:production"
            },
            "development": {
              "buildTarget": "photo-intake:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
